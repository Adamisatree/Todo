{
  "name": "linea-tasks",
  "version": "1.1.0",
  "private": true,
  "description": "Linea — offline-first desktop task manager",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "desktop:dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "app.linea.tasks",
    "productName": "Linea Tasks",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "icon": "assets/icon.png",
      "artifactName": "Linea-Tasks-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "Linea-Tasks-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Linea-Tasks-${version}-win-${arch}-setup.${ext}"
    }
  }
}
